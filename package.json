{
  "name": "qtypora",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Markdown desktop editor for Windows and macOS",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run build:icon",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:icon",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/github-release.test.cjs",
    "test:package:mac": "node --test scripts/package-mac.test.cjs",
    "test:desktop": "playwright test",
    "build:icon": "node scripts/create-icon.cjs",
    "package:win:internal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-internal.ps1",
    "package:mac:internal": "node scripts/package-mac-internal.cjs",
    "test:packaged": "playwright test tests/packaged.spec.ts --reporter=list --output=.debug/packaged-test-results"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@mathjax/src": "^4.0.0",
    "@xmldom/xmldom": "0.9.12",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
